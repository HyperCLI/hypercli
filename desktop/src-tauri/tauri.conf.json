{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyperCLI",
  "mainBinaryName": "HyperCLI",
  "version": "0.1.0",
  "identifier": "com.hypercli.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HyperCLI",
        "width": 440,
        "height": 500,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hypercli"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/buzz-backend-hypercli"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
