{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyperCLI",
  "mainBinaryName": "HyperCLI",
  "version": "0.1.1",
  "identifier": "com.hypercli.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HyperCLI",
        "width": 440,
        "height": 500,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "hypercli"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "HyperCLI, Inc.",
    "copyright": "\u00a9 2026 HyperCLI, Inc.",
    "category": "DeveloperTool",
    "shortDescription": "Connect your HyperCLI account and install the Buzz provider.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/buzz-backend-hypercli"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
