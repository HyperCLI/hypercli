{
  "name": "@hypercli.com/cli",
  "version": "0.1.0",
  "description": "HyperCLI command line — product APIs, managed agents, compute, flows, knowledge, voice.",
  "type": "module",
  "bin": {
    "hyper": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "npm run build:skills && tsc -p tsconfig.json",
    "build:skills": "node scripts/build-skills.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hypercli.com/sdk": "file:../ts-sdk"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
