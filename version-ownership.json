{
  "manifests": {
    "Cargo.toml": "app",
    "rs-sdk/Cargo.toml": "inherits:Cargo.toml",
    "py-cli/pyproject.toml": "excluded: legacy EOL CLI; ts-cli is the only active CLI release",
    "py-sdk/pyproject.toml": "app",
    "ts-cli/package.json": "app",
    "ts-sdk/package.json": "app"
  },
  "projections": [
    {"path": "Cargo.toml", "kind": "toml", "table": "workspace.package"},
    {"path": "Cargo.lock", "kind": "cargo-lock", "names": ["hypercli-sdk"]},
    {"path": "py-sdk/pyproject.toml", "kind": "toml", "table": "project"},
    {"path": "py-sdk/hypercli/__init__.py", "kind": "regex", "pattern": "^__version__ = \"(?P<version>[^\"]+)\""},
    {"path": "ts-sdk/package.json", "kind": "json", "keys": [["version"]]},
    {"path": "ts-cli/package.json", "kind": "json", "keys": [["version"]]},
    {"path": "ts-sdk/package-lock.json", "kind": "json", "keys": [["version"], ["packages", "", "version"]]},
    {"path": "ts-cli/package-lock.json", "kind": "json", "keys": [["version"], ["packages", "", "version"], ["packages", "../ts-sdk", "version"]]},
    {"path": "ts-sdk/src/version.ts", "kind": "generated", "content": "// Generated by tools/sync_versions.py from versions.json.\nexport const APP_VERSION = '{appVersion}';\n"},
    {"path": "ts-cli/src/version.ts", "kind": "generated", "content": "// Generated by tools/sync_versions.py from versions.json.\nexport const APP_VERSION = '{appVersion}';\n"}
  ]
}
